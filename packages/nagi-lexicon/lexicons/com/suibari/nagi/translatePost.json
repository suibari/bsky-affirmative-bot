{
  "lexicon": 1,
  "id": "com.suibari.nagi.translatePost",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "targetLang"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "targetLang": { "type": "string", "format": "language" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" }, "cached": { "type": "boolean" } }
        }
      }
    }
  }
}
