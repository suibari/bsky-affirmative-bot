{
  "lexicon": 1,
  "id": "com.suibari.nagi.searchActors",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["q"],
        "properties": {
          "q": { "type": "string", "maxLength": 256 },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 10
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actors"],
          "properties": {
            "actors": {
              "type": "array",
              "maxLength": 10,
              "items": { "type": "unknown" }
            }
          }
        }
      }
    }
  }
}
