{
  "lexicon": 1,
  "id": "com.suibari.nagi.getCommunityAffirmations",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["lang"],
        "properties": {
          "lang": {
            "type": "string",
            "knownValues": ["ja", "en"]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items", "hasMore"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#view" }
            },
            "cursor": { "type": "string" },
            "hasMore": { "type": "boolean" },
            "botActor": { "type": "unknown" }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": ["uri", "cid", "summary", "createdAt", "reactions"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "summary": { "type": "string", "maxLength": 320 },
        "createdAt": { "type": "string", "format": "datetime" },
        "reactions": {
          "type": "array",
          "items": { "type": "unknown" }
        },
        "images": {
          "type": "array",
          "items": { "type": "unknown" }
        },
        "linkCards": {
          "type": "array",
          "items": { "type": "unknown" }
        }
      }
    }
  }
}
