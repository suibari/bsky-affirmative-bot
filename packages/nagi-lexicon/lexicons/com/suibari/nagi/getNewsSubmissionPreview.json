{
  "lexicon": 1,
  "id": "com.suibari.nagi.getNewsSubmissionPreview",
  "defs": {
    "main": {
      "type": "query",
      "description": "公開記事URLから、ユーザー追加ニュース用の編集不可メタデータを取得する。",
      "parameters": {
        "type": "params",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri", "maxLength": 2048 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["articleId", "url", "title", "sourceName", "sourceUrl"],
          "properties": {
            "articleId": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "title": { "type": "string" },
            "sourceName": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri" },
            "publishedAt": { "type": "string", "format": "datetime" },
            "image": { "type": "string", "format": "uri" }
          }
        }
      },
      "errors": [{ "name": "MetadataUnavailable" }, { "name": "Duplicate" }]
    }
  }
}
