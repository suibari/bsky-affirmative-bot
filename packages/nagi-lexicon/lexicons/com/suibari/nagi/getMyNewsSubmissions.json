{
  "lexicon": 1,
  "id": "com.suibari.nagi.getMyNewsSubmissions",
  "defs": {
    "main": {
      "type": "query",
      "description": "認証した本人の最近のニュース審査依頼だけを返す。",
      "parameters": {
        "type": "params",
        "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 } }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "maxLength": 20,
              "items": {
                "type": "object",
                "required": ["uri", "cid", "url", "title", "status", "requestedAt"],
                "properties": {
                  "uri": { "type": "string", "format": "at-uri" },
                  "cid": { "type": "string", "format": "cid" },
                  "url": { "type": "string", "format": "uri" },
                  "title": { "type": "string" },
                  "status": {
                    "type": "string",
                    "knownValues": ["pending", "processing", "approved", "rejected", "failed", "cancelled"]
                  },
                  "reasonCode": { "type": "string" },
                  "requestedAt": { "type": "string", "format": "datetime" },
                  "finishedAt": { "type": "string", "format": "datetime" }
                }
              }
            }
          }
        }
      },
      "errors": [{ "name": "AuthRequired" }]
    }
  }
}
