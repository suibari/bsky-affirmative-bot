{
  "lexicon": 1,
  "id": "com.suibari.nagi.refreshPushSubscription",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["installationId", "capability", "endpoint", "keys"],
          "properties": {
            "installationId": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "capability": {
              "type": "string",
              "minLength": 32,
              "maxLength": 128
            },
            "endpoint": { "type": "string", "format": "uri" },
            "keys": { "type": "ref", "ref": "#pushKeys" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["registered"],
          "properties": { "registered": { "type": "boolean" } }
        }
      },
      "errors": [
        { "name": "InvalidCapability" },
        { "name": "EndpointConflict" }
      ]
    },
    "pushKeys": {
      "type": "object",
      "required": ["p256dh", "auth"],
      "properties": {
        "p256dh": { "type": "string" },
        "auth": { "type": "string" }
      }
    }
  }
}
