{
  "lexicon": 1,
  "id": "com.suibari.nagi.searchEmojis",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "q": { "type": "string", "maxLength": 64 },
          "repo": { "type": "string", "description": "Restrict results to a single repo (DID)." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["emojis"],
          "properties": {
            "emojis": { "type": "array", "items": { "type": "unknown" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
