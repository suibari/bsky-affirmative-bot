{
  "lexicon": 1,
  "id": "com.suibari.nagi.deletePushInstallation",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["installationId", "capability"],
          "properties": {
            "installationId": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "capability": {
              "type": "string",
              "minLength": 32,
              "maxLength": 128
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["deleted"],
          "properties": { "deleted": { "type": "integer", "minimum": 0 } }
        }
      },
      "errors": [{ "name": "InvalidCapability" }]
    }
  }
}
