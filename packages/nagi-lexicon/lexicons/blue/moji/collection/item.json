{
  "lexicon": 1,
  "id": "blue.moji.collection.item",
  "description": "Pinned from aendra-rininsland/bluemoji commit 25d5e0e8e5af0fbb36d6e2106b8f823a2c1cea90.",
  "defs": {
    "main": {
      "type": "record",
      "description": "A custom emoji",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["name", "createdAt", "formats"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Should be in the format :emoji:"
          },
          "alt": { "type": "string" },
          "createdAt": { "type": "string", "format": "datetime" },
          "formats": {
            "type": "union",
            "description": "Open union to allow for future formats",
            "refs": ["#formats_v0"],
            "closed": false
          },
          "adultOnly": { "type": "boolean", "default": false },
          "labels": {
            "type": "union",
            "refs": ["com.atproto.label.defs#selfLabels"]
          },
          "copyOf": { "type": "string", "format": "at-uri" },
          "fallbackText": {
            "type": "string",
            "maxLength": 10,
            "maxGraphemes": 1,
            "default": "◌"
          }
        }
      }
    },
    "formats_v0": {
      "type": "object",
      "properties": {
        "original": {
          "type": "blob",
          "accept": ["image/*", "application/lottie+zip"],
          "maxSize": 1000000
        },
        "png_128": { "type": "ref", "ref": "#blob_v0" },
        "apng_128": { "type": "ref", "ref": "#bytes_v0" },
        "gif_128": { "type": "ref", "ref": "#blob_v0" },
        "webp_128": { "type": "ref", "ref": "#blob_v0" },
        "lottie": { "type": "ref", "ref": "#bytes_v0" }
      }
    },
    "blob_v0": { "type": "blob", "maxSize": 262144 },
    "bytes_v0": { "type": "bytes", "maxLength": 65536 }
  }
}
