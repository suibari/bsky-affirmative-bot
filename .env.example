# Zenkoutei Bot-tan development environment
#
# Copy this file to .env and fill in only the groups needed by the services
# you run. Empty values below are secrets or deployment-specific identifiers.
# Never commit .env, service-account.json, app passwords, signing keys, or tokens.

# -----------------------------------------------------------------------------
# Common runtime and database
# -----------------------------------------------------------------------------

NODE_ENV=development
TZ=Asia/Tokyo
# Matches compose.dev.yml. The development fixture command refuses any database
# host/name other than a loopback nagi_dev database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/nagi_dev
URL_JETSTREAM=wss://jetstream2.us-east.bsky.network/subscribe
# Shared template selection for Bluesky and Nagi: random (default) or llm.
PREDEFINED_REPLY_SELECTOR=random
# Deprecated compatibility alias used only when PREDEFINED_REPLY_SELECTOR is unset.
# BSKY_PREDEFINED_SELECTOR=random

# Optional operator identity used by development/admin paths.
DEVELOPER_DID=

# -----------------------------------------------------------------------------
# Bluesky Bot-tan (apps/bsky_bot_server)
# -----------------------------------------------------------------------------

# Required: Bot-tan's DID and an AT Protocol app password.
BSKY_DID=
BSKY_APP_PASSWORD=

BSKY_BOT_SERVER_PORT=3001
BSKY_BOT_SERVER_URL=http://127.0.0.1:3001

# Optional integrations used by individual Bluesky features.
NEGAPOSI_URL=
ROOM_SERVER_URL=
ROOM_SERVER_SECRET=
ROOM_PAGE_URL=http://localhost:5174

# -----------------------------------------------------------------------------
# Nagi Bot-tan (apps/nagi_bot_server)
# -----------------------------------------------------------------------------

# Required: Nagi Bot-tan's DID and AT Protocol app password.
NAGI_BOT_DID=
NAGI_BOT_APP_PASSWORD=

NAGI_BOT_SERVER_PORT=3003
NAGI_BOT_SERVER_URL=http://127.0.0.1:3003
NAGI_APPVIEW_INTERNAL_URL=http://127.0.0.1:3005

# Optional feature and cost controls. Values shown are the code defaults.
NAGI_AI_USER_10M_LIMIT=10
NAGI_AI_USER_24H_LIMIT=60
NAGI_AI_SERVICE_10M_LIMIT=300
NAGI_AI_SERVICE_24H_LIMIT=2000
NAGI_CHANNEL_DORMANT_HOURS=168
NAGI_CHANNEL_SCAN_INTERVAL_MS=21600000

# -----------------------------------------------------------------------------
# Nagi AppView (apps/nagi_appview)
# -----------------------------------------------------------------------------

# Public and loopback-only listeners. These sample ports avoid collisions with
# the other services in this monorepo.
NAGI_PORT=3004
NAGI_HOST=127.0.0.1
NAGI_APPVIEW_INTERNAL_PORT=3005
NAGI_CLIENT_ORIGIN=http://localhost:5173

# Required for service-auth and indexing. Use your own did:web or did:plc.
NAGI_APPVIEW_DID=

NAGI_JETSTREAM_REPLAY_SECONDS=60
NAGI_RECONCILE_INTERVAL_MINUTES=360
NAGI_RECONCILE_CONCURRENCY=2
NAGI_EMOJI_ASSET_RATE_LIMIT=1200
NAGI_AFFIRMATION_THRESHOLD=86
# Deprecated compatibility alias; prefer NAGI_AFFIRMATION_THRESHOLD.
# NAGI_TREND_THRESHOLD=86
NAGI_USER_NEWS_DAILY_LIMIT=3
TRANSLATION_CONCURRENCY=2
TRANSLATION_MISS_LIMIT_PER_MINUTE=60

# Development-only authentication bypass. It is effective only in the
# development environment. Keep false unless you specifically need local viewer
# simulation.
APPVIEW_DEV_TRUST_VIEWER=false

# Optional semantic-search tuning. Leave blank to use code defaults.
SEARCH_ACTOR_SEM_DIST_MAX=
SEARCH_SEM_DIST_MAX=
SEARCH_SEM_REL_MARGIN=
OLLAMA_QUERY_PREFIX=

# Optional SSO ticket issuing for Bot-tan's Room. PASSPORT_PRIVATE_JWK must be a
# compact JSON object on one line. If omitted, SSO issuing is disabled.
PASSPORT_PRIVATE_JWK=
PASSPORT_ISSUER=http://localhost:3004
PASSPORT_AUDIENCES=http://localhost:5174
PASSPORT_TTL_SECONDS=60

# Optional Web Push. Both keys are required to enable push delivery. The
# Firebase Admin credential is not an env var in this repository: place the
# local service-account.json only when testing FCM, and never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# -----------------------------------------------------------------------------
# Biorhythm and shared scheduled posts (apps/biorhythm_server)
# -----------------------------------------------------------------------------

BIORHYTHM_SERVER_PORT=3002
BIORHYTHM_SERVER_HOST=127.0.0.1
BIORHYTHM_SERVER_URL=http://127.0.0.1:3002

# Required when callers use the internal API.
BIORHYTHM_INTERNAL_SECRET=

# In production this complete-match allowlist is required. Comma-separate each
# browser origin that may open the public WebSocket.
BIORHYTHM_WS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5174
BIORHYTHM_WS_MAX_CONNECTIONS=500
BIORHYTHM_WS_MAX_CONNECTIONS_PER_IP=10
BIORHYTHM_WS_MAX_BUFFERED_BYTES=1048576
BIORHYTHM_WS_HEARTBEAT_INTERVAL_MS=30000
BIORHYTHM_WS_SNAPSHOT_TTL_MS=5000

# Trust this header only when direct access to the origin server is blocked.
BIORHYTHM_TRUST_CF_CONNECTING_IP=false

# Valid targets: bsky, nagi. Valid top-post sources: bsky, nagi, combined.
SCHEDULED_POST_TARGETS=bsky,nagi
GOOD_NIGHT_TOP_POST_SOURCE=combined

# One-off status preview switch; normally prefer the --fresh CLI flag.
PLAN_REFRESH=0

# -----------------------------------------------------------------------------
# Bluesky labeler (apps/labeler_server)
# -----------------------------------------------------------------------------

# Required.
LABELER_DID=
LABELER_SIGNING_KEY=

# Required only for label publication/login operations.
LABELER_PASSWORD=

LABELER_DB_PATH=./labels.db
LABELER_SERVER_PORT=3400
LABELER_INTERNAL_PORT=3401
LABELER_SERVER_URL=http://127.0.0.1:3400
LABELER_PUBLIC_URL=http://127.0.0.1:3400
LABELER_INTERNAL_URL=http://127.0.0.1:3401

# -----------------------------------------------------------------------------
# Discord integration (apps/discord_bot)
# -----------------------------------------------------------------------------

DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
DISCORD_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Local and cloud AI
# -----------------------------------------------------------------------------

# Required by Gemini-backed features.
GEMINI_API_KEY=

# Ollama's OpenAI-compatible base URL includes /v1 in the current clients.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=snowflake-arctic-embed2
OLLAMA_TRANSLATION_MODEL=translategemma:4b
OLLAMA_BOT_TRANSLATION_MODEL=gemma3:4b

# Optional model alias overrides. Uncomment only when you intend to replace a
# registry default from packages/shared-configs/src/config/aiRoutes.ts.
# MODEL_GEMINI_LITE=gemini-2.5-flash-lite
# MODEL_GEMINI_FLASH=gemini-2.5-flash
# MODEL_GEMINI_35_LITE=gemini-3.5-flash-lite
# MODEL_GEMINI_36_FLASH=gemini-3.6-flash
# MODEL_GEMINI_IMAGE=gemini-2.5-flash-image-preview
# MODEL_GEMINI_EMBEDDING=gemini-embedding-001

# Advanced per-feature routing. Valid values are defined by AI_ROUTES in
# packages/shared-configs/src/config/aiRoutes.ts. The commented values below
# document current defaults; leaving them unset is recommended.
# AI_ROUTE_COMMON_USER_DIARY=35-lite-flex
# AI_ROUTE_COMMON_DIARY_ATTEMPT_EARLY=35-lite-flex
# AI_ROUTE_COMMON_DIARY_ATTEMPT_MID=35-lite-standard
# AI_ROUTE_COMMON_DIARY_ATTEMPT_LATE=35-lite-standard
# AI_ROUTE_BSKY_AFFIRMATIVE_REPLY=lite-flex
# AI_ROUTE_BSKY_CONVERSATION=lite-flex
# AI_ROUTE_BSKY_ANALYZE=lite-flex
# AI_ROUTE_BSKY_FORTUNE=lite-flex
# AI_ROUTE_BSKY_BOT_DIARY=lite-flex
# AI_ROUTE_BSKY_QUESTIONS_ANSWER=lite-flex
# AI_ROUTE_BSKY_RECOMMENDED_SONG=lite-flex
# AI_ROUTE_BSKY_WHIMSICAL_REPLY=lite-flex
# AI_ROUTE_BSKY_CHEER_SUBJECT=lite-flex
# AI_ROUTE_BSKY_CHEER_RESULT=lite-flex
# AI_ROUTE_BSKY_OMIKUJI=lite-flex
# AI_ROUTE_BSKY_ANNIVERSARY=lite-flex
# AI_ROUTE_BSKY_RECAP=lite-flex
# AI_ROUTE_BSKY_ROOM_WELCOME=lite-flex
# AI_ROUTE_BSKY_MY_MOOD_SONG=lite-flex
# AI_ROUTE_BSKY_IMAGE=image-auto
# AI_ROUTE_BIORHYTHM_SEASONAL_WORKS=flash-flex
# AI_ROUTE_BIORHYTHM_DAILY_PLAN=flash-standard
# AI_ROUTE_BIORHYTHM_STATUS=flash-flex
# AI_ROUTE_BIORHYTHM_GOOD_NIGHT=flash-flex
# AI_ROUTE_BIORHYTHM_QUESTION=flash-flex
# AI_ROUTE_BIORHYTHM_WHIMSICAL_POST_PLAN=flash-flex
# AI_ROUTE_BIORHYTHM_WHIMSICAL_POST_WRITE=flash-flex
# AI_ROUTE_NAGI_REPLY_ATTEMPT_EARLY=lite-flex
# AI_ROUTE_NAGI_REPLY_ATTEMPT_MID=lite-standard
# AI_ROUTE_NAGI_REPLY_ATTEMPT_LATE=flash-standard
# AI_ROUTE_NAGI_ANALYSIS=lite-standard
# AI_ROUTE_NAGI_CARD_COMMENT=lite-standard
# AI_ROUTE_NAGI_COMMUNITY_AFFIRMATION=lite-flex
# AI_ROUTE_NAGI_CHANNEL_WELCOME=lite-flex
# AI_ROUTE_NAGI_CHANNEL_TOPIC=lite-flex
# AI_ROUTE_NAGI_NAME_INTENT=lite-flex
# AI_ROUTE_NEWS_POSITIVE_GATE=lite-flex
# AI_ROUTE_NEWS_POSITIVE_COMMENT=lite-flex
# AI_ROUTE_OLLAMA_PREDEFINED_AFFIRMATION=ollama-chat
# AI_ROUTE_OLLAMA_NEWS_PRESCREEN=ollama-chat
# AI_ROUTE_OLLAMA_EMBED=ollama-embed
# AI_ROUTE_OLLAMA_TRANSLATION=ollama-translate
# AI_ROUTE_OLLAMA_BOT_TRANSLATION=ollama-bot-translate
# AI_ROUTE_OLLAMA_BIORHYTHM_STATUS=ollama-chat

# -----------------------------------------------------------------------------
# Optional external integrations
# -----------------------------------------------------------------------------

NEWSDATA_API_KEY=
YOUTUBE_API_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=

# Bot-tan diary publishing. Configure only the destinations you use.
LEAFLET_USERNAME=
LEAFLET_PUBLICATION_URL=
GITHUB_PAT=
GITHUB_DIARY_REPO=
GITHUB_DIARY_BRANCH=main
ZENN_USERNAME=
